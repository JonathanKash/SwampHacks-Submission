# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Where uploaded pool images and the SQLite db live.
DATA_DIR=./data
# Gemini image-editing model for the "restyle" edit (checked 2026-10-16: gemini-nano-banana-2.1,
# gemini-3.1-flash-image, gemini-3-pro-image). Image models need a billing-enabled key.
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional: required as X-Admin-Token header for POST /api/reset when set.
ADMIN_TOKEN=
# When the Gemini call fails (no billing, quota, offline), apply an OpenCV stylization instead.
RESTYLE_LOCAL_FALLBACK=true
# Low-memory mode: skip the CLIP model (saves ~1.5 GB RAM; restyle matching gets weaker).
USE_CLIP=true
# Optional: HMAC key so downloaded JSON reports can be verified as issued by this server (POST /api/verify-report).
REPORT_SIGNING_KEY=
